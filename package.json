{
    "name": "drawdy-world-flags",
    "version": "1.0.0",
    "description": "World Flags for Drawdy: every country flag, round, rectangle or square, to drag or click onto the board.",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "css": "node scripts/build-css.mjs",
        "catalog": "node scripts/build-catalog.mjs",
        "check-catalog": "node scripts/check-catalog.mjs",
        "dev": "node scripts/dev.mjs",
        "build": "node scripts/build-catalog.mjs && node scripts/build-css.mjs && node build.ts",
        "test": "tsx --test test/*.test.ts",
        "typecheck": "tsc --noEmit",
        "preflight": "node scripts/preflight.mjs"
    },
    "devDependencies": {
        "@drawdy/driver-protocol": "1.3.0",
        "@iconify-json/circle-flags": "1.2.12",
        "@iconify-json/flag": "1.2.13",
        "@rollup/plugin-typescript": "^12.1.2",
        "@tailwindcss/cli": "4.3.3",
        "@types/node": "^24",
        "fflate": "^0.8.2",
        "rollup": "^4.34.0",
        "tailwindcss": "4.3.3",
        "tslib": "^2.8.1",
        "tsx": "^4.20.0",
        "typescript": "^5",
        "vite": "^8.2.1"
    }
}
